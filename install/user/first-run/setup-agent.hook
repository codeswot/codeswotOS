#!/bin/bash

set -e

# codeswotOS ships no default agent, so invite once rather than picking one. An
# agent already chosen means the invitation has nothing to offer.
if [[ -z $(codeswot-default-agent) ]] && codeswot-done ensure agent-setup-invitation; then
  codeswot-notification-send -u critical -g 󰚩 "Set your default agent" \
    "Let your favorite agent help with codeswotOS." \
    --exec codeswot menu summon setup.default.agent
fi
