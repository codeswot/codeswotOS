#!/bin/bash

set -e

if codeswot-done ensure voxtype-install-invitation; then
  codeswot-notification-send -u critical -g  "Install Dictation with Voxtype" \
    "Click to install voice dictation for codeswotOS." \
    --exec codeswot-launch-floating-terminal-with-presentation codeswot-voxtype-install
fi
