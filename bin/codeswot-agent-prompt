#!/bin/bash

# codeswot:summary=Launch the default coding agent with a prompt
# codeswot:args=[--inline] <prompt...>
# codeswot:examples=codeswot agent prompt "Review this project"

# Prompts live here rather than on `codeswot agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: codeswot agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec codeswot-agent "${inline[@]}" --prompt "$*"
