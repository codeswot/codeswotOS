#!/bin/bash

# codeswot:summary=List available themes
# codeswot:examples=codeswot theme list | codeswot theme set "Tokyo Night"

{
  find ~/.config/codeswot/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$CODESWOT_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
