#!/bin/bash

# codeswot:summary=Print the installed codeswotOS version

omarchy_path=${CODESWOT_PATH:-/usr/share/codeswot}
omarchy_path=${omarchy_path%/}

if [[ $omarchy_path != "/usr/share/codeswot" ]]; then
  hash=$(git -C "$omarchy_path" rev-parse --short HEAD 2>/dev/null || true)

  if [[ -n $hash ]]; then
    echo "dev ($hash)"
  else
    echo "dev"
  fi

  exit 0
fi

# The edge channel installs codeswot-dev instead of codeswot, so check both.
for package in codeswot-dev codeswot; do
  version=$(pacman -Q "$package" 2>/dev/null | awk '{ print $2 }')
  [[ -n $version ]] && break
done

[[ -n $version ]] || exit 1

echo "$version"
