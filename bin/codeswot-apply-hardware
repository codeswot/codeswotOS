#!/bin/bash

# codeswot:summary=Apply codeswotOS hardware-specific packages and system configuration
# codeswot:group=apply
# codeswot:requires-sudo=true
# codeswot:examples=codeswot apply hardware --install-user dhh
# codeswot:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: codeswot apply hardware --install-user USER
       codeswot apply hardware --defer-provisioning

Runs idempotent hardware detection/setup for the installed machine. This is
called by codeswot-apply-system during ISO finalization and can be rerun later
for diagnostics or after hardware/package updates.

--defer-provisioning runs without an install user (deferred-provisioning installs create the user at
first boot); group grants are recorded in /var/lib/codeswot/provisioning/groups.
USAGE
}

install_user="${CODESWOT_INSTALL_USER:-}"
defer_provisioning=0
while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: codeswot-apply-hardware must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export CODESWOT_INSTALL_USER="$install_user"
export CODESWOT_PATH="${CODESWOT_PATH:-/usr/share/codeswot}"
export CODESWOT_INSTALL="${CODESWOT_INSTALL:-$CODESWOT_PATH/install}"
export CODESWOT_INSTALL_LOG_FILE="${CODESWOT_INSTALL_LOG_FILE:-/var/log/codeswot-install.log}"
export PATH="$CODESWOT_PATH/bin:$PATH"

source "$CODESWOT_INSTALL/helpers/logging.sh"
source "$CODESWOT_INSTALL/hardware/all.sh"
