#!/bin/bash

# codeswot:summary=Remove Tailscale and its bar plugin.
# codeswot:requires-sudo=true

tailscale down 2>/dev/null || true
systemctl --user disable --now codeswot-tailscale-receive.service 2>/dev/null || true
sudo systemctl disable --now tailscaled.service 2>/dev/null || true
codeswot-plugin-disable omarchy.tailscale
codeswot-webapp-remove "Tailscale" 2>/dev/null || true
codeswot-pkg-drop tailscale

echo ""
echo "Tailscale has been removed."
