#!/bin/bash

# codeswot:summary=Reinstall all default codeswotOS packages from the stable channel
# codeswot:requires-sudo=true

set -e

# Reinstall all default codeswotOS packages from the stable channel and downgrade any packages that are too new.

# Set the package repository to the stable mirrors
codeswot-refresh-pacman

# Downgrade any packages to the stable setup
sudo env CODESWOT_UPDATE_PACMAN=1 pacman -Suu --noconfirm

# Ensure all packages are installed
mapfile -t packages < <(grep -v '^#' "$CODESWOT_PATH/install/codeswot-base.packages" | grep -v '^$')
sudo env CODESWOT_UPDATE_PACMAN=1 pacman -Syu --noconfirm --needed "${packages[@]}"
