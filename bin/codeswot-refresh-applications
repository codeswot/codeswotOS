#!/bin/bash

# codeswot:summary=Ensure default application launchers and mise wrappers are installed.

# Copy .desktop declarations
mkdir -p ~/.local/share/applications
cp "$CODESWOT_PATH"/applications/*.desktop ~/.local/share/applications/

if codeswot-cmd-present alacritty; then
  cp "$CODESWOT_PATH/default/alacritty/Alacritty.desktop" ~/.local/share/applications/
fi

if [[ -f "$CODESWOT_PATH/install/user/mise.sh" ]]; then
  bash "$CODESWOT_PATH/install/user/mise.sh"
fi

update-desktop-database ~/.local/share/applications
