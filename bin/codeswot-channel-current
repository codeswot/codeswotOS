#!/bin/bash

# codeswot:summary=Print the active codeswotOS package channel

set -euo pipefail

# Dev is a linked source checkout: CODESWOT_PATH points somewhere other than
# the package-backed install at /usr/share/omarchy. This takes precedence over
# the package channels, since the checkout overrides whatever is installed.
if [[ $CODESWOT_PATH != "/usr/share/codeswot" ]]; then
  echo dev
  exit 0
fi

# codeswot-dev / codeswot-settings-dev are only shipped from the edge package
# repo, so their presence alone means edge. codeswot / codeswot-settings come
# from either the stable or rc mirror, distinguished by codeswot-version-channel
# (which reports the mirror as its first token).
if pacman -Q codeswot-dev codeswot-settings-dev >/dev/null 2>&1; then
  echo edge
elif pacman -Q codeswot codeswot-settings >/dev/null 2>&1; then
  channel=$(codeswot-version-channel 2>/dev/null | awk '{ print $1 }')
  case "$channel" in
    stable) echo stable ;;
    rc) echo rc ;;
    *) echo unknown ;;
  esac
else
  echo unknown
fi
