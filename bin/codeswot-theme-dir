#!/bin/bash

# codeswot:summary=Print the directory holding a theme, preferring a user-installed copy
# codeswot:args=<theme-name>
# codeswot:examples=codeswot theme dir tokyo-night

theme="${1:-}"

if [[ -z $theme ]]; then
  echo "Usage: codeswot-theme-dir <theme-name>" >&2
  exit 1
fi

if [[ -d $HOME/.config/codeswot/themes/$theme ]]; then
  echo "$HOME/.config/codeswot/themes/$theme"
else
  echo "$CODESWOT_PATH/themes/$theme"
fi
