#!/bin/bash

# codeswot:summary=Select and set the system timezone
# codeswot:group=menu
# codeswot:name=timezone

set -e

timezone=$(timedatectl list-timezones | codeswot-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
codeswot-shell -q omarchy.clock refresh
codeswot-notification-send "Timezone is now set to $timezone"
