#!/bin/bash

# codeswot:summary=Install and configure Voxtype dictation
# codeswot:requires-sudo=true

set -e

# Install voxtype and configure it for use.

if gum confirm "Install Voxtype + AI model (~150MB) to enable dictation?"; then
  codeswot-pkg-add wtype voxtype-bin

  # Setup voxtype
  mkdir -p ~/.config/voxtype
  cp "$CODESWOT_PATH/default/voxtype/config.toml" ~/.config/voxtype/

  voxtype setup --download --no-post-install
  if codeswot-hw-vulkan; then
    voxtype setup gpu --enable || true
  fi
  voxtype setup systemd

  hyprctl reload >/dev/null
  codeswot-restart-shell
  codeswot-notification-send -g  "Voxtype Dictation Ready" "Hold F9 to dictate (or toggle with Super + Ctrl + X)." -t 10000
fi
