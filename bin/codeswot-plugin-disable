#!/bin/bash

# codeswot:summary=Disable a shell plugin
# codeswot:group=plugin
# codeswot:args=<id>

set -euo pipefail

fail() {
  echo "codeswot-plugin-disable: $*" >&2
  exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: codeswot plugin disable <id>"
  exit 0
fi

id="${1:-}"
[[ -n $id ]] || fail "plugin id is required"

result=$(codeswot-shell shell setPluginEnabled "$id" false)
[[ $result == "ok" ]] ||
  fail "plugin '$id' is not known; run: codeswot-shell shell rescanPlugins"

echo "Disabled $id"
