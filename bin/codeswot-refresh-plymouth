#!/bin/bash

# codeswot:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the codeswotOS default and rebuild it.
# codeswot:requires-sudo=true

# Reuse the fixed-file publisher so root never resolves the source checkout or
# follows a destination symlink while restoring the packaged assets.
exec "$CODESWOT_PATH/bin/codeswot-plymouth-set" --refresh-default
