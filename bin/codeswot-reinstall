#!/bin/bash

# codeswot:summary=Reinstall codeswotOS packages and reset default configs
# codeswot:requires-sudo=true

set -e

echo -e "This will reinstall all default codeswotOS packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  codeswot-reinstall-pkgs
  codeswot-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && codeswot-system-reboot
fi
