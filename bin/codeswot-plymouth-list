#!/bin/bash

# codeswot:summary=List themes that can style the Plymouth boot screen
# codeswot:examples=codeswot plymouth list

{
  find ~/.config/codeswot/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n' 2>/dev/null
  find "$CODESWOT_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  if [[ -f $(codeswot-theme-dir "$name")/preview-unlock.png ]]; then
    echo "$name"
  fi
done
