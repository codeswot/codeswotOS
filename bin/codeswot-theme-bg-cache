#!/bin/bash

# codeswot:summary=Cache background switcher thumbnails for the current theme

theme_name=$(cat "$HOME/.local/state/codeswot/current/theme.name" 2>/dev/null)

codeswot-menu-images \
  --cache-only \
  "$HOME/.local/state/codeswot/current/theme/backgrounds" \
  "$HOME/.config/codeswot/backgrounds/$theme_name"
