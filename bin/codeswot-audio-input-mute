#!/bin/bash

# codeswot:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  codeswot-brightness-keyboard-mute on
  codeswot-osd -i microphone-muted -m "Microphone muted"
else
  codeswot-brightness-keyboard-mute off
  codeswot-osd -i microphone -m "Microphone on"
fi
