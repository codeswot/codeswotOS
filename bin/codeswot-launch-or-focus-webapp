#!/bin/bash

# codeswot:summary=Launch or focus on a given web app identified by the window-pattern.
# codeswot:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: codeswot-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="codeswot-launch-webapp $@"

exec codeswot-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
