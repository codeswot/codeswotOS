#!/bin/bash

# codeswot:summary=Install a Nerd Font package and switch the system to it
# codeswot:args=<display-name> <package> <family>
# codeswot:examples=codeswot install font 'Cascadia Mono' ttf-cascadia-mono-nerd 'CaskaydiaMono Nerd Font'

name="${1-}"
package="${2-}"
family="${3-}"

if [[ -z $name || -z $package || -z $family ]]; then
  echo "Usage: codeswot-install-font <display-name> <package> <family>" >&2
  exit 1
fi

printf -v install_message '%q' "Installing ${name}..."
printf -v package_arg '%q' "$package"
printf -v family_arg '%q' "$family"

exec codeswot-launch-floating-terminal-with-presentation \
  "echo ${install_message}; codeswot-pkg-add ${package_arg} && sleep 2 && codeswot-font-set ${family_arg}"
