#!/bin/bash

# codeswot:summary=Display the {C}odeswot logo in the terminal using the theme accent color.

clear

hex=$(codeswot-theme-color accent 2>/dev/null || true)
hex=${hex#\#}
if [[ $hex =~ ^[0-9a-fA-F]{6}$ ]]; then
  echo -e "\033[38;2;$((16#${hex:0:2}));$((16#${hex:2:2}));$((16#${hex:4:2}))m"
else
  echo -e "\033[32m"
fi

if [[ -f ~/.config/codeswot/branding/logo.txt ]]; then
  cat ~/.config/codeswot/branding/logo.txt
else
  cat "$CODESWOT_PATH/logo.txt"
fi
echo -e "\033[0m"
echo
