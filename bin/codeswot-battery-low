#!/bin/bash

# codeswot:summary=Send the low battery warning notification and run battery-low hooks.
# codeswot:args=<percentage>
# codeswot:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: codeswot-battery-low <percentage>" >&2
  exit 1
fi

level=$1

codeswot-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
codeswot-hook battery-low "$level"
