#!/bin/bash

# codeswot:summary=Launch a TUI or focus an existing terminal window for it
# codeswot:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.omarchy.$(basename "$1")"
fi

LAUNCH_COMMAND="codeswot-launch-tui $@"

exec codeswot-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
