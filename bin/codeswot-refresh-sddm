#!/bin/bash

# codeswot:summary=Refresh the SDDM theme from default
# codeswot:requires-sudo=true

# Reuse the fixed-file publisher so root never resolves an untrusted source or
# follows a destination symlink while restoring the packaged SDDM theme.
exec "$CODESWOT_PATH/bin/codeswot-plymouth-set" --refresh-sddm-default
