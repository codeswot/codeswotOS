#!/bin/bash

# codeswot:summary=Remove the GeForce NOW Flatpak app and its data.
# codeswot:group=remove
# codeswot:name=gaming geforce-now

set -e

if codeswot-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
