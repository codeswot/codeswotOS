#!/bin/bash

# codeswot:summary=Set the codeswotOS package channel.
# codeswot:args=<stable|rc|edge|dev>
# codeswot:requires-sudo=true

set -euo pipefail

usage() { echo "Usage: codeswot-channel-set [stable|rc|edge|dev]"; }
fail() { echo "Error: $*" >&2; exit 1; }

confirm_dev() {
  cat <<'WARNING'

The dev channel links codeswotOS directly to a checkout of the source in ~/omarchy.
It's exclusively intended for developers working on codeswotOS itself.

WARNING

  gum confirm --default=false "Switch to dev channel?"
}

validate_dev_checkout() {
  local checkout="$1"

  if [[ -e $checkout && ! -d $checkout/.git ]]; then
    fail "$checkout already exists and is not a git checkout."
  fi

  if [[ -d $checkout/.git && ( ! -d $checkout/bin || ! -d $checkout/default || ! -d $checkout/shell ) ]]; then
    fail "$checkout is a git checkout, but it does not look like codeswotOS."
  fi
}

link_dev_checkout() {
  local checkout="$1"
  [[ -d $checkout/.git ]] || git clone https://github.com/omacom/omarchy.git "$checkout"

  codeswot-dev-link "$checkout" --no-reboot
}

(( $# > 0 )) || { usage; exit 1; }

dev_checkout=""
channel="$1"
leaving_dev=0

case "$channel" in
  stable)
    pacman_channel=stable
    packages=(codeswot codeswot-settings)
    ;;
  rc)
    pacman_channel=rc
    packages=(codeswot codeswot-settings)
    ;;
  edge)
    pacman_channel=edge
    packages=(codeswot-dev codeswot-settings-dev)
    ;;
  dev)
    confirm_dev || { echo "Cancelled."; exit 0; }
    dev_checkout="$HOME/codeswot"
    validate_dev_checkout "$dev_checkout"
    pacman_channel=edge
    packages=(codeswot-dev codeswot-settings-dev)
    ;;
  *)
    echo "Unknown channel: $channel" >&2
    usage >&2
    exit 1
    ;;
esac

if [[ -z $dev_checkout && $CODESWOT_PATH != "/usr/share/codeswot" ]]; then
  leaving_dev=1
fi

if [[ -n $dev_checkout ]]; then
  link_dev_checkout "$dev_checkout"
  export CODESWOT_PATH="$dev_checkout"
  export PATH="$CODESWOT_PATH/bin:$PATH"
  codeswot-state set reboot-required
fi

codeswot-refresh-pacman "$pacman_channel"
# --ask 4 accepts codeswot <-> codeswot-dev replacement prompts without file overwrites.
sudo env CODESWOT_UPDATE_PACMAN=1 pacman -S --needed --noconfirm --ask 4 "${packages[@]}"

if [[ -z $dev_checkout ]]; then
  codeswot-dev-unlink --no-reboot
  export CODESWOT_PATH=/usr/share/codeswot

  if (( leaving_dev )); then
    codeswot-state set reboot-required
  fi
fi

codeswot-update -y
