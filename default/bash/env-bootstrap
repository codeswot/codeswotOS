# Single source of truth for CODESWOT_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/codeswot.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-codeswot          (Hyprland session via uwsm)
#   /usr/share/codeswot/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/codeswot.conf is written by codeswot-dev-link and reset by
# codeswot-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -f /etc/codeswot.conf ]; then
  . /etc/codeswot.conf
  : "${CODESWOT_PATH:=/usr/share/codeswot}"
else
  CODESWOT_PATH=/usr/share/codeswot
fi
export CODESWOT_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/codeswot-* via the codeswot package — prepending
# /usr/share/codeswot/bin would just be noise.
if [ "$CODESWOT_PATH" != /usr/share/codeswot ]; then
  case ":$PATH:" in
    *":${CODESWOT_PATH%/}/bin:"*) ;;
    *) PATH="${CODESWOT_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
