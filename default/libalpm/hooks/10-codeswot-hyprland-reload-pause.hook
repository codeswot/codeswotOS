[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = codeswot-settings
Target = codeswot-settings-dev

[Action]
Description = Pausing Hyprland config auto-reload for codeswotOS settings update...
When = PreTransaction
Depends = codeswot
Exec = /usr/bin/codeswot-hyprland-reload-guard pause
